<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESP32 RTDB Monitor Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-900 text-gray-100 font-sans antialiased min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="bg-gray-800 border-b border-gray-700 shadow-lg">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-microchip text-indigo-400 text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wider">ESP32 RTDB Monitor</h1>
            </div>
            <div class="flex items-center space-x-4">
                <nav class="hidden md:flex items-center space-x-2 text-sm">
                    <a href="/" class="px-3 py-1.5 rounded bg-indigo-600 text-white transition font-semibold"><i class="fas fa-home mr-1"></i> Dashboard</a>
                    <a href="/calendar" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 transition"><i class="fas fa-calendar mr-1"></i> Kalender</a>
                    <a href="/logs" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 transition"><i class="fas fa-list-alt mr-1"></i> Jumlah Log</a>
                </nav>
                <span class="text-xs bg-gray-700 px-3 py-1.5 rounded-full text-gray-300 truncate max-w-xs hidden lg:inline-block" title="<%= rtdbUrl %>">
                    <i class="fas fa-database text-green-400 mr-1.5"></i> <%= rtdbUrl %>
                </span>
                <button id="refresh-btn" onclick="fetchData()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded text-sm transition flex items-center shadow">
                    <i class="fas fa-sync-alt mr-1.5"></i> Refresh
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="container mx-auto px-6 py-8 flex-grow">
        <% if (error) { %>
            <div class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded mb-6 flex items-center shadow">
                <i class="fas fa-exclamation-triangle mr-3 text-xl"></i>
                <span><strong>Error:</strong> <%= error %></span>
            </div>
        <% } %>

        <!-- Stats Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gray-800 border border-gray-700 rounded-lg p-6 shadow-md flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider font-semibold">Total Boot Events</p>
                    <p id="stat-boot-count" class="text-3xl font-extrabold text-indigo-400 mt-1"><%= bootEvents.length %></p>
                </div>
                <div class="bg-indigo-900 bg-opacity-50 p-4 rounded-full text-indigo-300">
                    <i class="fas fa-power-off text-2xl"></i>
                </div>
            </div>

            <div class="bg-gray-800 border border-gray-700 rounded-lg p-6 shadow-md flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider font-semibold">Registered Devices</p>
                    <p id="stat-device-count" class="text-3xl font-extrabold text-green-400 mt-1"><%= devices.length %></p>
                </div>
                <div class="bg-green-900 bg-opacity-50 p-4 rounded-full text-green-300">
                    <i class="fas fa-wifi text-2xl"></i>
                </div>
            </div>

            <div class="bg-gray-800 border border-gray-700 rounded-lg p-6 shadow-md flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-wider font-semibold">Last Updated</p>
                    <p id="stat-last-updated" class="text-sm font-medium text-gray-300 mt-2"><%= lastUpdated %></p>
                </div>
                <div class="bg-blue-900 bg-opacity-50 p-4 rounded-full text-blue-300">
                    <i class="fas fa-clock text-2xl"></i>
                </div>
            </div>
        </div>

        <!-- Devices Status Section -->
        <section class="mb-10">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold flex items-center"><i class="fas fa-server text-green-400 mr-2"></i> Connected / Registered Devices</h2>
                <span class="text-xs text-gray-400">Path: <code class="bg-gray-800 px-1.5 py-0.5 rounded text-gray-300">/devices</code></span>
            </div>
            <div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden shadow-md">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-700 text-left text-sm">
                        <thead class="bg-gray-900 text-gray-400 uppercase tracking-wider text-xs">
                            <tr>
                                <th class="px-6 py-3">MAC / Device ID</th>
                                <th class="px-6 py-3">IP Address</th>
                                <th class="px-6 py-3">GPS Location</th>
                                <th class="px-6 py-3">Boot Time (ms)</th>
                            </tr>
                        </thead>
                        <tbody id="devices-tbody" class="divide-y divide-gray-700">
                            <% if (devices.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="px-6 py-4 text-center text-gray-400 italic">No device records found in RTDB.</td>
                                </tr>
                            <% } else { %>
                                <% devices.forEach(dev => { %>
                                    <tr class="hover:bg-gray-750 transition">
                                        <td class="px-6 py-4 font-mono text-indigo-300"><%= dev.mac %></td>
                                        <td class="px-6 py-4 font-mono"><%= dev.ip || 'N/A' %></td>
                                        <td class="px-6 py-4 font-mono"><%= dev.gps || 'N/A' %></td>
                                        <td class="px-6 py-4 font-mono"><%= dev.bootTimeMs || 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Boot Events Log Section -->
        <section>
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold flex items-center"><i class="fas fa-list-alt text-indigo-400 mr-2"></i> Live Boot Events Log</h2>
                <div class="flex items-center space-x-3">
                    <label class="flex items-center cursor-pointer text-xs text-gray-300">
                        <input type="checkbox" id="auto-refresh-toggle" class="form-checkbox h-4 w-4 text-indigo-600 rounded bg-gray-700 border-gray-600 mr-1.5">
                        Auto-refresh (5s)
                    </label>
                    <span class="text-xs text-gray-400">Path: <code class="bg-gray-800 px-1.5 py-0.5 rounded text-gray-300">/bootEvents</code></span>
                </div>
            </div>
            <div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden shadow-md">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-700 text-left text-sm">
                        <thead class="bg-gray-900 text-gray-400 uppercase tracking-wider text-xs">
                            <tr>
                                <th class="px-6 py-3">Event Key ID</th>
                                <th class="px-6 py-3">IP Address</th>
                                <th class="px-6 py-3">GPS Location</th>
                                <th class="px-6 py-3">Boot Time (ms)</th>
                            </tr>
                        </thead>
                        <tbody id="logs-tbody" class="divide-y divide-gray-700">
                            <% if (bootEvents.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="px-6 py-4 text-center text-gray-400 italic">No boot events logged yet.</td>
                                </tr>
                            <% } else { %>
                                <% bootEvents.forEach(evt => { %>
                                    <tr class="hover:bg-gray-750 transition">
                                        <td class="px-6 py-4 font-mono text-gray-300 text-xs" title="<%= evt.id %>"><%= evt.id.substring(0, 16) %>...</td>
                                        <td class="px-6 py-4 font-mono"><%= evt.ip || 'N/A' %></td>
                                        <td class="px-6 py-4 font-mono"><%= evt.gps || 'N/A' %></td>
                                        <td class="px-6 py-4 font-mono"><%= evt.bootTimeMs || 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 border-t border-gray-700 py-4 mt-8 text-center text-xs text-gray-400">
        <p>ESP32 RTDB Monitor &bull; Built with Express & Tailwind CSS</p>
    </footer>

    <!-- Frontend Script for Auto-Refresh -->
    <script>
        let autoRefreshInterval = null;

        async function fetchData() {
            const btn = document.getElementById('refresh-btn');
            btn.classList.add('opacity-50');
            try {
                const res = await fetch('/api/logs');
                const data = await res.json();
                if (data.success) {
                    updateUI(data.bootEvents, data.devices, data.lastUpdated);
                }
            } catch (err) {
                console.error('Failed to fetch logs:', err);
            } finally {
                btn.classList.remove('opacity-50');
            }
        }

        function updateUI(bootEvents, devices, lastUpdated) {
            // Update stats
            document.getElementById('stat-boot-count').innerText = bootEvents.length;
            document.getElementById('stat-device-count').innerText = devices.length;
            document.getElementById('stat-last-updated').innerText = new Date(lastUpdated).toLocaleString();

            // Update devices table
            const devicesTbody = document.getElementById('devices-tbody');
            if (devices.length === 0) {
                devicesTbody.innerHTML = '<tr><td colspan="4" class="px-6 py-4 text-center text-gray-400 italic">No device records found in RTDB.</td></tr>';
            } else {
                devicesTbody.innerHTML = devices.map(dev => `
                    <tr class="hover:bg-gray-750 transition">
                        <td class="px-6 py-4 font-mono text-indigo-300">${dev.mac || 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${dev.ip || 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${dev.gps || 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${dev.bootTimeMs || 'N/A'}</td>
                    </tr>
                `).join('');
            }

            // Update logs table
            const logsTbody = document.getElementById('logs-tbody');
            if (bootEvents.length === 0) {
                logsTbody.innerHTML = '<tr><td colspan="4" class="px-6 py-4 text-center text-gray-400 italic">No boot events logged yet.</td></tr>';
            } else {
                logsTbody.innerHTML = bootEvents.map(evt => `
                    <tr class="hover:bg-gray-750 transition">
                        <td class="px-6 py-4 font-mono text-gray-300 text-xs" title="${evt.id}">${evt.id ? evt.id.substring(0, 16) + '...' : 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${evt.ip || 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${evt.gps || 'N/A'}</td>
                        <td class="px-6 py-4 font-mono">${evt.bootTimeMs || 'N/A'}</td>
                    </tr>
                `).join('');
            }
        }

        const toggle = document.getElementById('auto-refresh-toggle');
        toggle.addEventListener('change', (e) => {
            if (e.target.checked) {
                autoRefreshInterval = setInterval(fetchData, 5000);
            } else {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
            }
        });
    </script>
</body>
</html>
