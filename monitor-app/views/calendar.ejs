<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalender Aktivitas Device & Log RTDB</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* HTML, CSS, dan JS dicampur dalam satu file */
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
        }
        .day-cell {
            min-height: 100px;
            transition: all 0.2s ease;
        }
        .day-cell:hover {
            background-color: rgba(79, 70, 229, 0.1);
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans antialiased min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="bg-gray-800 border-b border-gray-700 shadow-lg">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fas fa-calendar-alt text-indigo-400 text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wider">Kalender Monitor RTDB</h1>
            </div>
            <nav class="flex items-center space-x-3 text-sm">
                <a href="/" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 transition"><i class="fas fa-home mr-1"></i> Dashboard</a>
                <a href="/calendar" class="px-3 py-1.5 rounded bg-indigo-600 text-white transition font-semibold"><i class="fas fa-calendar mr-1"></i> Kalender</a>
                <a href="/logs" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 transition"><i class="fas fa-list-alt mr-1"></i> Jumlah Log</a>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="container mx-auto px-6 py-8 flex-grow">
        <!-- Header Controls & Summary -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 bg-gray-800 p-4 rounded-lg border border-gray-700 shadow-md">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
                <button onclick="changeMonth(-1)" class="bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded text-sm transition"><i class="fas fa-chevron-left"></i> Bulan Lalu</button>
                <h2 id="month-year-title" class="text-xl font-bold text-indigo-300"></h2>
                <button onclick="changeMonth(1)" class="bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded text-sm transition">Bulan Depan <i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="flex items-center space-x-4 text-sm">
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 rounded-full bg-indigo-500 inline-block"></span>
                    <span class="text-gray-300">Device Push</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
                    <span class="text-gray-300">Jumlah Log</span>
                </div>
            </div>
        </div>

        <!-- Calendar Container -->
        <div class="bg-gray-800 border border-gray-700 rounded-lg shadow-lg overflow-hidden mb-8">
            <!-- Days of Week Header -->
            <div class="calendar-grid bg-gray-900 border-b border-gray-700 text-center font-semibold text-gray-400 text-xs py-3 uppercase">
                <div>Min</div>
                <div>Sen</div>
                <div>Sel</div>
                <div>Rab</div>
                <div>Kam</div>
                <div>Jum</div>
                <div>Sab</div>
            </div>
            <!-- Calendar Days Grid -->
            <div id="calendar-days" class="calendar-grid divide-x divide-y divide-gray-700 bg-gray-800">
                <!-- Injected via JavaScript -->
            </div>
        </div>

        <!-- Selected Date Detail Modal / Section -->
        <div id="date-detail-section" class="bg-gray-800 border border-gray-700 rounded-lg p-6 shadow-lg hidden">
            <div class="flex justify-between items-center mb-4 border-b border-gray-700 pb-3">
                <h3 id="selected-date-title" class="text-lg font-bold text-indigo-300 flex items-center">
                    <i class="fas fa-info-circle mr-2"></i> Detail Aktivitas Tanggal: <span id="active-date-str"></span>
                </h3>
                <button onclick="closeDetail()" class="text-gray-400 hover:text-white"><i class="fas fa-times text-lg"></i></button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h4 class="text-sm font-semibold text-gray-400 uppercase mb-3"><i class="fas fa-server text-indigo-400 mr-1"></i> Device yang Push (<span id="detail-device-count">0</span>)</h4>
                    <div id="detail-devices-list" class="space-y-2 max-h-60 overflow-y-auto pr-2">
                        <!-- Devices list -->
                    </div>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-400 uppercase mb-3"><i class="fas fa-list-alt text-green-400 mr-1"></i> Log / Boot Events (<span id="detail-log-count">0</span>)</h4>
                    <div id="detail-logs-list" class="space-y-2 max-h-60 overflow-y-auto pr-2">
                        <!-- Logs list -->
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 border-t border-gray-700 py-4 text-center text-xs text-gray-400">
        <p>ESP32 RTDB Monitor &bull; Kalender Aktivitas Device & Log</p>
    </footer>

    <!-- JavaScript & Styling Mixed -->
    <script>
        // Data calendar dari server
        const calendarData = <%- JSON.stringify(calendarData || {}) %>;

        // Auto-select month/year based on latest available log date, or current date if empty
        const dates = Object.keys(calendarData).sort();
        let initialDate = new Date();
        
        if (dates.length > 0) {
            const latestDateStr = dates[dates.length - 1]; // e.g. '2026-11-19'
            const latestDate = new Date(latestDateStr);
            
            // If the latest log is in the future or significantly far from today, 
            // we still might want to show today or the latest log month.
            // For now, we follow the latest log date if it exists.
            if (!isNaN(latestDate.getTime())) {
                initialDate = latestDate;
            }
        }
        
        let currentDate = new Date(initialDate.getFullYear(), initialDate.getMonth(), 1);

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            document.getElementById('month-year-title').innerText = `${monthNames[month]} ${year}`;

            const firstDayIndex = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();

            const calendarDaysEl = document.getElementById('calendar-days');
            calendarDaysEl.innerHTML = '';

            // Padding for previous month
            for (let i = 0; i < firstDayIndex; i++) {
                calendarDaysEl.innerHTML += `<div class="day-cell bg-gray-850 p-2 opacity-30"></div>`;
            }

            // Days of current month
            for (let day = 1; day <= totalDays; day++) {
                const monthStr = String(month + 1).padStart(2, '0');
                const dayStr = String(day).padStart(2, '0');
                const dateKey = `${year}-${monthStr}-${dayStr}`;

                const dayStats = calendarData[dateKey] || { logCount: 0, deviceCount: 0, devices: [], logs: [] };

                let badgeHtml = '';
                if (dayStats.logCount > 0 || dayStats.deviceCount > 0) {
                    badgeHtml = `
                        <div class="mt-2 space-y-1 text-xs">
                            <div class="bg-indigo-900 text-indigo-200 px-1.5 py-0.5 rounded flex justify-between items-center">
                                <span><i class="fas fa-server mr-1"></i> Dev:</span>
                                <span class="font-bold">${dayStats.deviceCount}</span>
                            </div>
                            <div class="bg-green-900 text-green-200 px-1.5 py-0.5 rounded flex justify-between items-center">
                                <span><i class="fas fa-list mr-1"></i> Log:</span>
                                <span class="font-bold">${dayStats.logCount}</span>
                            </div>
                        </div>
                    `;
                }

                calendarDaysEl.innerHTML += `
                    <div class="day-cell p-2.5 flex flex-col justify-between cursor-pointer border border-gray-700/50" onclick="showDateDetail('${dateKey}')">
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-semibold text-gray-300">${day}</span>
                            ${(dayStats.logCount > 0 || dayStats.deviceCount > 0) ? '<span class="w-2 h-2 rounded-full bg-green-400"></span>' : ''}
                        </div>
                        ${badgeHtml}
                    </div>
                `;
            }
        }

        function changeMonth(direction) {
            currentDate.setMonth(currentDate.getMonth() + direction);
            renderCalendar();
        }

        function showDateDetail(dateKey) {
            const dayStats = calendarData[dateKey] || { logCount: 0, deviceCount: 0, devices: [], logs: [] };
            
            document.getElementById('active-date-str').innerText = dateKey;
            document.getElementById('detail-device-count').innerText = dayStats.deviceCount;
            document.getElementById('detail-log-count').innerText = dayStats.logCount;

            const devicesListEl = document.getElementById('detail-devices-list');
            if (dayStats.devices.length === 0) {
                devicesListEl.innerHTML = '<p class="text-xs text-gray-400 italic">Tidak ada device yang push pada tanggal ini.</p>';
            } else {
                devicesListEl.innerHTML = dayStats.devices.map(devId => `
                    <div class="bg-gray-900 p-2.5 rounded border border-gray-700 text-xs font-mono text-indigo-300">
                        <i class="fas fa-microchip mr-1.5 text-indigo-400"></i> ${devId}
                    </div>
                `).join('');
            }

            const logsListEl = document.getElementById('detail-logs-list');
            if (dayStats.logs.length === 0) {
                logsListEl.innerHTML = '<p class="text-xs text-gray-400 italic">Tidak ada log boot event pada tanggal ini.</p>';
            } else {
                logsListEl.innerHTML = dayStats.logs.map(evt => `
                    <div class="bg-gray-900 p-2.5 rounded border border-gray-700 text-xs">
                        <div class="flex justify-between text-gray-400 mb-1">
                            <span>IP: <strong class="text-gray-200">${evt.ip || 'N/A'}</strong></span>
                            <span>Boot: <strong class="text-indigo-300">${evt.bootTimeMs || 'N/A'}ms</strong></span>
                        </div>
                        <div class="text-gray-500 font-mono truncate">GPS: ${evt.gps || 'N/A'}</div>
                    </div>
                `).join('');
            }

            document.getElementById('date-detail-section').classList.remove('hidden');
            document.getElementById('date-detail-section').scrollIntoView({ behavior: 'smooth' });
        }

        function closeDetail() {
            document.getElementById('date-detail-section').classList.add('hidden');
        }

        // Initialize
        renderCalendar();
    </script>
</body>
</html>
